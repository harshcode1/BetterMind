# Copy to .env.local and fill in. Never commit real values (.env* is git-ignored except this file).

# --- Required ---------------------------------------------------------------
# MongoDB connection string (Atlas or local), including the database name.
MONGODB_URI=

# Secret used to sign login cookies (JWT). Generate with: openssl rand -base64 48
# The app refuses to authenticate anyone if this is missing.
JWT_SECRET=

# Master secret for encrypting mood notes and assessment answers. Generate with: openssl rand -base64 48
# Changing it makes already-encrypted data unreadable, so keep it stable once in use.
ENCRYPTION_SECRET=

# --- Optional ---------------------------------------------------------------
# Salt mixed into the per-user key derivation. Leave unset to use the built-in default.
# Do not change it once data exists (it would make old data unreadable).
ENCRYPTION_SALT=

# API key for the AI chat (Llama 3.3 via Groq, through the OpenAI-compatible SDK).
# Without it the chat falls back to keyword-based replies.
LLM_API_KEY=

# Google Calendar sync (appointments). Leave empty to disable.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
